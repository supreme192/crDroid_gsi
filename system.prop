# ==========================================
# MOTOR VISUAL LIQUID GLASS & FLUIDEZ 144HZ+
# ==========================================
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.use_color_management=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.max_frame_rate=144

# Renderizador nativo (SkiaVK) com composição dinâmica para evitar gargalos
debug.hwui.renderer=skiavk
debug.composition.type=dyn
debug.sf.latch_unsignaled=1
ro.physics.animation.spring=true

# ==========================================
# MODO JOGO, LATÊNCIA ZERO E TOQUE
# ==========================================
persist.sys.game.perf_mode=1
ro.config.game_mode_boost=true
ro.joy.game_mode.enabled=1

# Resposta instantânea ao toque e atrito de rolagem
touch.pressure.scale=0.001
view.scroll_friction=0.008

# Aceleração de vídeo e perfis de hardware
debug.egl.hw=1
debug.egl.profiler=0
video.accelerate.hw=1

# ==========================================
# GERENCIAMENTO INTELIGENTE (FLAGSHIP) & ART
# ==========================================
# Equilíbrio de multitarefa para evitar thrashing de RAM
ro.sys.fw.bg_apps_limit=32
ro.vendor.qti.sys.fw.bservice_enable=true
persist.sys.purgeable_assets=1

# Compilação moderna: rápida inicialização e máximo desempenho
dalvik.vm.dex2oat-filter=speed-profile
dalvik.vm.image-dex2oat-filter=speed-profile
